{
    "compilerOptions": {
        "module": "NodeNext",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "sourceMap": true,
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "NodeNext",
        "baseUrl": ".",
        "paths": {
            "@modelcontextprotocol/sdk/*": [
                "node_modules/@modelcontextprotocol/sdk/*"
            ],
            "axios": [
                "node_modules/axios"
            ],
            "zod": [
                "node_modules/zod"
            ]
        }
    },
    "include": [
        "src",
        "../mcp-common/src"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}